{% extends 'base.html.twig' %}

{% block title %}API | MVC Course{% endblock %}

{% block body %}
    <h1>JSON API Documentation</h1>
    
    <p class="lead">
        This page documents the available JSON API endpoints for this application.
    </p>
    
    <div class="api-endpoints">
        <div class="endpoint">
            <h2>Card Deck</h2>
            <p>Returns the complete deck of cards sorted by suit and value.</p>
            
            <div class="endpoint-details">
                <p><strong>URL:</strong> <code>/api/deck</code></p>
                <p><strong>Method:</strong> GET</p>
                <p><strong>Response Format:</strong> JSON</p>
            </div>
        </div>

        <div class="endpoint">
            <h2>Shuffle Deck</h2>
            <p>Shuffles the deck and returns the shuffled cards.</p>
            
            <div class="endpoint-details">
                <p><strong>URL:</strong> <code>/api/deck/shuffle</code></p>
                <p><strong>Method:</strong> POST</p>
                <p><strong>Response Format:</strong> JSON</p>
            </div>
        </div>

        <div class="endpoint">
            <h2>Draw Card</h2>
            <p>Draws a card from the deck.</p>
            
            <div class="endpoint-details">
                <p><strong>URL:</strong> <code>/api/deck/draw</code></p>
                <p><strong>Method:</strong> POST</p>
                <p><strong>Response Format:</strong> JSON</p>
            </div>
        </div>

        <div class="endpoint">
            <h2>Draw Multiple Cards</h2>
            <p>Draws multiple cards from the deck.</p>
            
            <div class="endpoint-details">
                <p><strong>URL:</strong> <code>/api/deck/draw/{number}</code></p>
                <p><strong>Method:</strong> POST</p>
                <p><strong>Response Format:</strong> JSON</p>
            </div>
        </div>

        <div class="endpoint">
            <h2>Quote of the Day</h2>
            <p>Returns a random quote along with the current date and timestamp.</p>
            
            <div class="endpoint-details">
                <p><strong>URL:</strong> <a href="{{ path('api_quote') }}"><code>/api/quote</code></a></p>
                <p><strong>Method:</strong> GET</p>
                <p><strong>Response Format:</strong> JSON</p>
                
                <h3>Example Response:</h3>
                <pre><code>
{
    "quote": "Life is what happens when you're busy making other plans.",
    "date": "2023-04-15",
    "timestamp": 1681568000
}
                </code></pre>
            </div>
        </div>

        <div class="endpoint">
            <h2>Game 21 Status</h2>
            <p>Returns the current state of the Game 21.</p>
            
            <div class="endpoint-details">
                <p><strong>URL:</strong> <a href="{{ path('api_game') }}"><code>/api/game</code></a></p>
                <p><strong>Method:</strong> GET</p>
                <p><strong>Response Format:</strong> JSON</p>
                
                <h3>Example Response:</h3>
                <pre><code>
{
    "gameState": "playing",
    "result": "",
    "isGameOver": false,
    "playerHand": {
        "count": 2,
        "cards": [
            {
                "suit": "Hearts",
                "value": "7",
                "symbol": "♥",
                "numericValue": 7
            },
            {
                "suit": "Clubs",
                "value": "King",
                "symbol": "♣",
                "numericValue": 10
            }
        ]
    },
    "dealerHand": {
        "count": 1,
        "cards": [
            {
                "suit": "Diamonds",
                "value": "5",
                "symbol": "♦",
                "numericValue": 5
            }
        ]
    },
    "playerScore": 17,
    "dealerScore": 5,
    "actions": {
        "hit": "/game/player/hit",
        "stand": "/game/player/stand",
        "reset": "/game/reset"
    }
}
                </code></pre>
            </div>
        </div>

        <div class="endpoint">
            <h2>Library Books</h2>
            <p>Returns all books in the library.</p>
            
            <div class="endpoint-details">
                <p><strong>URL:</strong> <a href="{{ path('api_library_books') }}"><code>/api/library/books</code></a></p>
                <p><strong>Method:</strong> GET</p>
                <p><strong>Response Format:</strong> JSON</p>
            </div>
        </div>

        <div class="endpoint">
            <h2>Get Book by ISBN</h2>
            <p>Returns details about a specific book by its ISBN number.</p>
            
            <div class="endpoint-details">
                <p><strong>URL:</strong> <code>/api/library/book/{isbn}</code> (Example: <a href="/~maix24/dbwebb-kurser/mvc/me/report/public/api/library/book/9781234567890"><code>/api/library/book/9781234567890</code></a>)</p>
                <p><strong>Method:</strong> GET</p>
                <p><strong>Response Format:</strong> JSON</p>
            </div>
        </div>
    </div>
{% endblock %}