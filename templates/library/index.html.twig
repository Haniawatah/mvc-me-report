{% extends 'base.html.twig' %}

{% block title %}Library | MVC Course{% endblock %}

{% block body %}
    <h1>Book Library</h1>
    
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
    
    {% if error_message is defined and error_message %}
        <div class="flash-error">
            {{ error_message }}
        </div>
    {% endif %}
    
    <div class="action-links">
        <a href="{{ path('library_new') }}" class="btn">Add New Book</a>
    </div>
    
    <div class="book-list">
        {% if books is empty %}
            <p>No books found in the library. Add your first book!</p>
        {% else %}
            {% for book in books %}
                <div class="book-card">
                    <div class="book-image">
                        {% if book.image %}
                            <img src="{{ book.image }}" alt="{{ book.title }}">
                        {% else %}
                            <div class="no-image">No Image</div>
                        {% endif %}
                    </div>
                    <div class="book-info">
                        <h2 class="book-title">{{ book.title }}</h2>
                        <p class="book-author">by {{ book.author }}</p>
                        <p class="book-isbn">ISBN: {{ book.isbn }}</p>
                    </div>
                    <div class="book-actions">
                        <a href="{{ path('library_show', {'id': book.id}) }}" class="btn">View</a>
                        <a href="{{ path('library_edit', {'id': book.id}) }}" class="btn">Edit</a>
                        <form method="post" action="{{ path('library_delete', {'id': book.id}) }}" onsubmit="return confirm('Are you sure you want to delete this book?');" style="display: inline;">
                            <input type="hidden" name="_token" value="simple_token_{{ book.id }}">
                            <button class="btn btn-danger">Delete</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}
