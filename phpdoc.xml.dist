<?xml version="1.0" encoding="UTF-8"?>
<phpdocumentor configVersion="3">
  <paths>
    <output>build/phpdoc</output>
    <cache>build/.phpdoc-cache</cache>
  </paths>
  <version number="1.0.0">
    <api>
      <source dsn=".">
        <path>src/Proj</path>
      </source>
      <ignore hidden="true">
        <path>vendor</path>
        <path>tests</path>
        <path>proj</path>
        <path>public</path>
      </ignore>
    </api>
  </version>
</phpdocumentor>
